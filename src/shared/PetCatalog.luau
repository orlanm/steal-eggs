--!strict
-- Explorer: ReplicatedStorage.BabyBeastsShared.PetCatalog
-- Single source of truth for animated pets. Data lives in PetCatalogData/*.luau (generated by
-- _tools/pets/gen_catalog.py from _tools/pets/registry.json); every module in that folder is merged,
-- so the catalog scales by adding chunk modules - no code changes needed for new pets.
--
-- Entry fields:
--   Id           export folder id (unique)          GameName  name used by GameEgg/GamePet/TankBeasts
--   DisplayName  UI name                            Bounds    model size in studs (X, Y up, Z)
--   Rig          "Skinned" | "Rigid"                Model     Model asset id (0 = not uploaded yet)
--   Texture      colour atlas image asset id        Animations { Idle, Walk, Hatch } asset ids
--   Aliases?     extra names that resolve to this pet
--   VfxCount?    ambient effects around the pet (default PetVfxPool.DefaultCount)
--   Vfx?         explicit PetVfxPool effect ids (overrides VfxCount)
--   BaseScale?   per-species tuning of the static pen size (PetScale), default 1

export type Entry = {
	Id: string,
	GameName: string,
	DisplayName: string,
	Bounds: Vector3,
	Rig: string,
	Model: number,
	Texture: number,
	Animations: { Idle: number, Walk: number, Hatch: number },
	Aliases: { string }?,
	VfxCount: number?,
	Vfx: { string }?,
	WalkGait: string?,
	-- per-species tuning of the static base scale (PetScale), default 1
	BaseScale: number?,
	-- generated egg (pets with no Steal An Egg egg): one textured mesh, see _tools/pets/eggs
	Egg: { Mesh: number, Texture: number, Size: Vector3 }?,
}

local PetCatalog = {}

local list: { Entry } = {}
local byKey: { [string]: Entry } = {}

local function key(s: string): string
	return string.lower((string.gsub(s, "[^%w]", "")))
end

local dataFolder = script.Parent:WaitForChild("PetCatalogData")
local modules = dataFolder:GetChildren()
table.sort(modules, function(a, b)
	return a.Name < b.Name
end)
for _, module in modules do
	if not module:IsA("ModuleScript") then
		continue
	end
	for _, entry in require(module) :: { Entry } do
		assert(byKey["id:" .. entry.Id] == nil, "[PetCatalog] duplicate pet id " .. entry.Id)
		table.insert(list, entry)
		byKey["id:" .. entry.Id] = entry
		for _, name in { entry.Id, entry.GameName, entry.DisplayName, table.unpack(entry.Aliases or {}) } do
			local k = key(name)
			if byKey[k] == nil then
				byKey[k] = entry
			end
		end
	end
end

-- Look up by id, game name, display name or alias (case/punctuation-insensitive).
function PetCatalog.get(name: string): Entry?
	return byKey["id:" .. name] or byKey[key(name)]
end

function PetCatalog.all(): { Entry }
	return list
end

-- True once the pet's model has been uploaded (animations are optional per clip).
function PetCatalog.hasModel(entry: Entry?): boolean
	return entry ~= nil and entry.Model ~= 0
end

function PetCatalog.animationId(entry: Entry, clip: string): string?
	local id = (entry.Animations :: any)[clip]
	if typeof(id) == "number" and id ~= 0 then
		return "rbxassetid://" .. id
	end
	return nil
end

return PetCatalog
